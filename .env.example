# ============================================
# MODO DE MANUTENÇÃO
# ============================================
# Ativar modo de manutenção (true/false)
# Quando true, o sistema exibe apenas uma página estática
# e NÃO inicializa banco de dados, rotas ou APIs
MAINTENANCE_MODE=false

# ============================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ============================================
# PostgreSQL (obrigatório - Docker Compose)
DATABASE_URL=postgresql://multimax:multimax123@postgres:5432/multimax

# SQLite (DESCONTINUADO - remover em próximas versões)
# DB_FILE_PATH=/opt/multimax-data/estoque.db

# ============================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ============================================
SECRET_KEY=uma_chave_secreta_muito_forte_e_aleatoria
DEBUG=false
HOST=0.0.0.0
PORT=5000

# ============================================
# KEEPALIVE (opcional)
# ============================================
# Mantém o serviço ativo fazendo ping periódico
KEEPALIVE_ENABLED=false
KEEPALIVE_URL=https://multimax.tec.br/health
KEEPALIVE_INTERVAL=300

# ============================================
# NOTIFICAÇÕES (opcional)
# ============================================
NOTIFICACOES_ENABLED=false

# ============================================
# DIRETÓRIOS DE DADOS
# ============================================
DATA_DIR=/opt/multimax-data
MULTIMAX_DATA_DIR=/multimax-data

# ============================================
# VERSIONAMENTO
# ============================================
APP_VERSION=
